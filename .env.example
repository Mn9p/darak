# ───────────── Core ─────────────
# SQLite for local dev; PostgreSQL for staging/production (provider auto-detected by scripts/db-provider.mjs)
DATABASE_URL="file:./dev.db"   # resolved relative to packages/db/prisma/schema/
# Production (Neon): the POOLED url for the app, e.g.
# postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&connection_limit=5
# (migrations and backups use the direct url, see DEPLOYMENT.md)
# DATABASE_URL="postgresql://darak:darak@localhost:5432/darak?schema=public"

# 64+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production the app refuses to start when either secret is missing, shorter than 32 chars, or still "change-me".
AUTH_SECRET="change-me"
# Protects GET /api/cron/run — accepted only as `Authorization: Bearer <CRON_SECRET>` (Vercel Cron sends it automatically)
CRON_SECRET="change-me"
# Public base URL (used in emails / links)
APP_URL="http://localhost:3000"
# ───────────── Sign-in (mobile number + SMS code) ─────────────
# Comma-separated Saudi mobiles that become platform admins (/admin) on first sign-in. Example: 0500000000,0555555555
SUPER_ADMIN_PHONES=""
# Closed test: while set, ONLY these comma-separated mobiles can receive a login code or be set as a login number.
# Leave empty to let every registered number (staff, owners, tenants) sign in.
LOGIN_ALLOWED_PHONES=""
# Where the login code goes when no SMS provider is configured.
#   auto (default): shown on screen in development only · never: SMS only · always: also shown on screen (development/staging)
# In production the code is NEVER shown unless BOTH OTP_ECHO=always AND ALLOW_OTP_ECHO_IN_PROD=1 are set — use that
# only for the stakeholder test before the SMS vendor is connected, and remove both before real users sign in.
# Without an SMS provider and without echo, sign-in answers "خدمة الرسائل غير مفعّلة بعد".
OTP_ECHO="auto"
# ALLOW_OTP_ECHO_IN_PROD="1"

# Set to "false" only when serving production over plain http (LAN IP without TLS)
COOKIE_SECURE="true"
LOG_LEVEL="info"

# ───────────── File storage ─────────────
# local (default, ./uploads on disk) | s3 (AWS S3, Cloudflare R2, MinIO, Supabase Storage — any S3 API)
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION="me-south-1"
S3_ENDPOINT=""            # leave empty for AWS; set for R2/MinIO e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ───────────── Messaging channels (leave empty → simulated + logged) ─────────────
# Email: Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="DARAK <noreply@example.sa>"
# SMS: Authentica (https://authentica.sa, login codes only — send-otp with our own code), Unifonic (https://unifonic.com) or
# Msegat (https://msegat.com) for login codes AND free-text reminders. All Saudi CITC-registered. Without any, login codes show on screen (OTP_ECHO=auto).
SMS_PROVIDER="unifonic"      # authentica | unifonic | msegat
# Authentica: API key from portal.authentica.sa → Applications (sent as X-Authorization). Template id from portal → Templates (default 1).
# The key looks like $2y$10$… and .env loaders treat $NAME as a variable, corrupting it. In a .env file use the base64 form:
#   node -e "console.log(Buffer.from(process.argv[1]).toString('base64'))" '<key>'
# On Vercel/Docker (env vars injected directly) the raw key in AUTHENTICA_API_KEY works too.
AUTHENTICA_API_KEY_B64=""
AUTHENTICA_API_KEY=""
AUTHENTICA_TEMPLATE_ID=""
UNIFONIC_APP_SID=""
UNIFONIC_SENDER_ID="DARAK"
MSEGAT_USERNAME=""
MSEGAT_API_KEY=""
MSEGAT_SENDER=""
# WhatsApp Business (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ───────────── Assistant (Gemini, free tier: https://aistudio.google.com/apikey) — leave empty → built-in summaries ─────────────
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# ───────────── Observability ─────────────
SENTRY_DSN=""

# ───────────── Backups (scripts/backup.mjs) ─────────────
BACKUP_DIR="./backups"
BACKUP_S3_BUCKET=""
BACKUP_RETENTION_DAYS="30"

# ───────────── Team contact (landing page, login, help) ─────────────
# Shown as WhatsApp / email links and notified on every "request an account" submission. Offices are opened by the team only.
SUPPORT_PHONE=""
SUPPORT_EMAIL=""

# ───────────── Vercel only ─────────────
# ENABLE_EXPERIMENTAL_COREPACK="1"   # use the pinned pnpm 9.15.9
